PORT=8787
AXIMACH_API_KEY=replace-with-a-long-random-secret
AXIMACH_DATA_FILE=/data/aximach.json
# Comma-separated exact browser/app origins allowed to call this server; do not use "*".
# Replace the example web origin with your actual Pages/custom domain.
# https://localhost is the default Android Capacitor origin; capacitor://localhost is for iOS.
# Append ,null only when the packaged Electron Windows app must call this API; "null" is an opaque origin,
# so use a long private API key and do not expose this prototype API to untrusted users.
AXIMACH_ALLOWED_ORIGINS=https://your-aximach-app.example.com,https://localhost,capacitor://localhost,http://localhost:5173,null
# Backward-compatible single-origin setting; AXIMACH_ALLOWED_ORIGINS takes precedence when set.
# AXIMACH_ALLOWED_ORIGIN=https://your-aximach-app.example.com
WHATSAPP_ACCESS_TOKEN=configure-in-host-secrets
WHATSAPP_PHONE_NUMBER_ID=configure-in-host-secrets
WHATSAPP_GRAPH_VERSION=v23.0
