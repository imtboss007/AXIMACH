{
  "name": "aximach",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "AXIMACH Manufacturing OS",
  "author": "AXIMACH",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "cap:sync": "cap sync android",
    "cap:android": "cap open android",
    "package:windows": "npm run build && electron-builder --win nsis --x64 --publish never",
    "start:scheduler": "node server/index.mjs",
    "start:whatsapp-web": "node server/whatsapp-web.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@whiskeysockets/baileys": "^6.7.18"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "com.aximach.manufacturingos",
    "productName": "AXIMACH Manufacturing OS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
